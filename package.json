{
  "name": "climb-you",
  "version": "0.1.0",
  "description": "長期目標を日次クエストに分解し、自然と登頂＝達成へ導く山登りUX",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\" \"npm run dev:mcp\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "dev:mcp": "cd mcp-server && npm run dev",
    "build": "npm run build:frontend && npm run build:backend && npm run build:mcp",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npm run build",
    "build:mcp": "cd mcp-server && npm run build",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "cd frontend && npm test",
    "test:backend": "cd backend && npm test",
    "test:coverage": "npm run test:frontend -- --coverage && npm run test:backend -- --coverage",
    "db:migrate": "cd database && npm run migrate",
    "db:rollback": "cd database && npm run rollback",
    "db:seed": "cd database && npm run seed",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\""
  },
  "keywords": [
    "goal-tracking",
    "habit-tracking",
    "productivity",
    "gamification"
  ],
  "author": "climb-you team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  }
}
