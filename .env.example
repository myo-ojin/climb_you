# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/climb_you
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4

# OAuth
OAUTH_CLIENT_ID=your_client_id
OAUTH_CLIENT_SECRET=your_client_secret
OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback

# JWT
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=7d

# Scheduler
QUEST_GENERATION_TIME=04:00
TIMEZONE=Asia/Tokyo

# Storage (for evidence files)
STORAGE_TYPE=local
STORAGE_PATH=./uploads
# AWS_S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Monitoring
SENTRY_DSN=
LOG_LEVEL=info

# Feature Flags
ENABLE_AUTO_QUEST_GENERATION=true
ENABLE_LEARNING_ENGINE=true
ENABLE_STAGNATION_DETECTION=true
